# --- Database ---
# SQLite lokal (default). Dipakai bila DATABASE_URL kosong.
MONEV_DB=data/monev.db
# Postgres/Supabase (mis. postgres://user:pass@host:5432/db). Bila diisi, ini MENANG
# atas MONEV_DB; serverless memakai jalur ini. TLS otomatis untuk host non-localhost.
DATABASE_URL=

# --- Admin (wajib bila HOST bukan 127.0.0.1) ---
# Server menolak start tanpa sandi saat host terbuka, karena halaman admin
# bisa menarik data dan mengubah penugasan.
MONEV_ADMIN_PASSWORD=
# Kunci tanda tangan cookie admin. Kosong = diturunkan dari sandi (ganti sandi = semua
# cookie lama batal). Isi hanya bila sandi kosong tetapi cookie tetap harus bertanda.
MONEV_ADMIN_SECRET=

# --- Web ---
HOST=127.0.0.1
PORT=4321

# --- Sumber SSI ---
# Profil user SSI. Ambil dari tab SSI di browser: localStorage.getItem('user_eksternal').
# Satu baris JSON. Bila diisi, nilai id/name/organitazion_ihs/partner_code/user_type di bawah diabaikan.
# SSI menolak permintaan dengan "kode faskes tidak sesuai" bila faskes_code tidak sama dengan organisasi pemilik token.
SSI_USER_EKSTERNAL_JSON=
SSI_FASKES_CODE=1000057936
SSI_USER_ID=1221065
SSI_FULLNAME=Nama Petugas
SSI_PARTNER_CODE=
SSI_USER_TYPE=
# 2000 lebih aman: 5000 terbukti memicu HTTP 500 dari SSI untuk rentang lebar.
SSI_PAGE_SIZE=2000
# Rentang tarik data. Nilai ini hanya CADANGAN: bila admin menyimpan rentang di halaman
# admin (Status sistem → Tarik data mulai/sampai), nilai dari DB yang dipakai.
SSI_SWEEP_START=2020-01-01
SSI_SWEEP_END=2030-12-31

# --- Opsional: topologi collector terpisah (kosongkan untuk satu mode/prod) ---
MONEV_PUSH_TARGET=
MONEV_PUSH_TOKEN=
MONEV_INGEST_TOKEN=

# Di belakang reverse proxy (nginx/Caddy/container platform): pakai X-Forwarded-For
# untuk IP asli, dan paksa cookie Secure walau TLS diputus di proxy.
MONEV_TRUST_PROXY=0
MONEV_COOKIE_SECURE=0

# Batas halaman per request sync. Kosong = tanpa batas (proses panjang).
# Di Vercel otomatis 2 karena satu request dibatasi waktu; sisa halaman dilanjutkan
# lewat cursor (tombol Tarik data SSI berikutnya).
MONEV_SYNC_MAX_PAGES=
# Anggaran waktu per request sync (ms). Di Vercel otomatis 200000: halaman baru tidak
# dimulai bila sudah lewat batas, jadi request tidak dipotong di tengah halaman.
MONEV_SYNC_MAX_MS=
